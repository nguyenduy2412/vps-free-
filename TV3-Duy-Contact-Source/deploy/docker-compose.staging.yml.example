# TV3 staging override example. Review and adapt with the team's infra owner.
# It intentionally does not define public networking/TLS/firewall or remove the
# local SQL port from the base Compose file; those are environment-level controls.
services:
  api:
    environment:
      ASPNETCORE_ENVIRONMENT: Staging
      Seed__Tv3LocalDemoData: "false"
      Seed__VisualQaData: "false"
      # Required. Set FRONTEND_STAGING_ORIGIN in the protected staging env file
      # to one exact browser origin, for example https://staging.example.com.
      # Do not include a path, trailing slash, wildcard, or comma-separated list.
      Cors__AllowedOrigins__0: ${FRONTEND_STAGING_ORIGIN:?Set FRONTEND_STAGING_ORIGIN to the exact public frontend origin}
