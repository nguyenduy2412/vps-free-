    "name": "CloudServiceStore — TV3 Handoff",
    "description": "Collection tester cho Landing/Customers, News Management và Contact Request. Không dùng payload testimonial/logo giả; các body đó là biến môi trường cần thay bằng dữ liệu đã được chấp thuận.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Authentication helper",
      "item": [
        {
          "name": "Đăng nhập Admin (lấy accessToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{apiBaseUrl}}/auth/login",
            "description": "Điền tài khoản seed/local thật trong environment. Không lưu password vào collection."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.environment.set('accessToken', data.accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
